    },
    "A": {
      "label": "核心学术期刊/知名学者著作",
      "examples": "核心期刊论文, 知名学者新书",
      "credibility": 4
    },
    "B": {
      "label": "深度媒体报道/行业报告",
      "examples": "ScienceDaily, EurekAlert, 36氪深度",
      "credibility": 3
    },
    "C": {
      "label": "优质自媒体深度文",
      "examples": "知乎深度回答, 公众号深度分析",
      "credibility": 2
    },
    "D": {
      "label": "碎片化口水文（不收录）",
